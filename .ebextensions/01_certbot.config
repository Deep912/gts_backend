commands:
  01_install_certbot:
    command: |
      amazon-linux-extras install epel -y
      yum install -y certbot

  02_setcap_node:
    command: |
      sudo setcap 'cap_net_bind_service=+ep' $(which node)

container_commands:
  01_stop_nginx:
    command: "sudo systemctl stop nginx"
  02_run_certbot:
    command: |
      certbot certonly --standalone --non-interactive --agree-tos --email deepchhegaliya@gmail.com -d gtsbackend.ap-south-1.elasticbeanstalk.com
    leader_only: true
  03_start_nginx:
    command: "sudo systemctl start nginx"

files:
  "/etc/cron.d/certbot-renew":
    mode: "000644"
    owner: root
    group: root
    content: |
      0 0,12 * * * root /usr/bin/certbot renew --quiet
